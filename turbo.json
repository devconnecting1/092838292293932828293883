{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "env": [
        "NEXT_PUBLIC_SUPABASE_URL",
        "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY",
        "NEXT_PUBLIC_SUPABASE_ANON_KEY",
        "NEXT_PUBLIC_SITE_URL",
        "PORTAL_FEED_TOKEN",
        "PORTAL_FEED_EMAIL",
        "NEXT_PUBLIC_PAGAMENTO_INSTRUCOES",
        "NEXT_PUBLIC_BRAND_NAME",
        "NEXT_PUBLIC_BRAND_LEGAL_NAME",
        "NEXT_PUBLIC_BRAND_CNPJ",
        "NEXT_PUBLIC_BRAND_CRECI",
        "NEXT_PUBLIC_BRAND_ADDRESS",
        "NEXT_PUBLIC_BRAND_PRIMARY",
        "NEXT_PUBLIC_BRAND_LOGO_URL",
        "NEXT_PUBLIC_SUPPORT_WHATSAPP_LABEL",
        "NEXT_PUBLIC_GTM_ID",
        "NEXT_PUBLIC_COTAS_GRUPO_URL",
        "PORTAL_LEADS_TOKEN",
        "GRUPO_OLX_SECRET_KEY",
        "IMOVELWEB_CLIENT_ID",
        "IMOVELWEB_CLIENT_SECRET",
        "IMOVELWEB_CODIGO_IMOBILIARIA",
        "IMOVELWEB_AMBIENTE",
        "IMOVELWEB_API_URL",
        "IMOVELWEB_CALLBACK_SECRET",
        "DATAJUD_API_KEY",
        "ESCAVADOR_TOKEN",
        "ANTHROPIC_API_KEY",
        "CERTIDOES_MODELO",
        "PORTAL_STRIPE_SECRET_KEY",
        "PORTAL_STRIPE_WEBHOOK_SECRET",
        "PORTAL_BILLING_TOKEN",
        "NEXT_PUBLIC_SUPPORT_WHATSAPP",
        "NEXT_PUBLIC_SUPPORT_EMAIL",
        "NEXT_PUBLIC_ROOT_DOMAIN",
        "NEXT_PUBLIC_TENANCY_MODE",
        "NEXT_PUBLIC_VERCEL_PROJECT_PRODUCTION_URL",
        "VERCEL_PROJECT_PRODUCTION_URL",
        "CAPTURE_FORM_SECRET",
        "CAPTURE_SERVER_KEY",
        "LEAD_SERVER_KEY",
        "NEXT_SERVER_ACTIONS_ENCRYPTION_KEY",
        "STRIPE_SECRET_KEY",
        "STRIPE_WEBHOOK_SECRET",
        "BILLING_SERVER_KEY",
        "NOTIFICATION_SERVER_KEY",
        "CAIXA_SERVER_KEY",
        "CAIXA_PHOTOS_ENABLED",
        "PLATFORM_ADMIN_EMAILS",
        "PLATFORM_SERVER_KEY",
        "LEAD_INGEST_SERVER_KEY",
        "META_APP_SECRET",
        "META_WEBHOOK_VERIFY_TOKEN",
        "NEXT_PUBLIC_META_APP_ID",
        "NEXT_PUBLIC_META_WHATSAPP_CONFIG_ID",
        "CONNECTIONS_SERVER_KEY",
        "ORGANIZATION_DELETION_SERVER_KEY",
        "CRON_SECRET",
        "BREVO_API_KEY",
        "EMAIL_FROM_ADDRESS",
        "EMAIL_FROM_NAME",
        "EMAIL_DAILY_LIMIT",
        "EMAIL_REPLY_TO",
        "NEXT_PUBLIC_VAPID_PUBLIC_KEY",
        "VAPID_PRIVATE_KEY",
        "VAPID_SUBJECT"
      ],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "format": {
      "dependsOn": ["^format"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
